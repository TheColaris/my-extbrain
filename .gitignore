# 依赖（server/、web/ 内各有细化 .gitignore，此处为顶层兜底）
node_modules/

# 环境与密钥——绝不入库
.env
.env.*

# 日志与系统文件
*.log
.DS_Store

# IDE
.idea/
.vscode/

# 本地工作目录（不入库）
.trellis/

# E2E 洁净室运行时产物（e2e.sh / run-journey.mjs 自动生成，不入库；
# server.log 由上方 *.log 覆盖）
script/e2e/bin/
script/e2e/.cli-home/
script/e2e/.e2e-vapid.env
